<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity TaxEvent.
    -->
    <changeSet id="20231202115137-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="account_id"
                                 baseTableName="tax_event"
                                 constraintName="fk_tax_event__account_id"
                                 referencedColumnNames="id"
                                 referencedTableName="broker_account"
                                 />

        <addForeignKeyConstraint baseColumnNames="operation_id"
                                 baseTableName="tax_event"
                                 constraintName="fk_tax_event__operation_id"
                                 referencedColumnNames="id"
                                 referencedTableName="operation"
                                 />

        <addForeignKeyConstraint baseColumnNames="income_event_id"
                                 baseTableName="tax_event"
                                 constraintName="fk_tax_event__income_event_id"
                                 referencedColumnNames="id"
                                 referencedTableName="income_event"
                                 />
    </changeSet>
</databaseChangeLog>
